generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Payment {
  id        Int      @id @default(autoincrement())
  orderId   Int      @unique
  userId    Int
  amount    Float
  status    String
  method    String
  createdAt DateTime @default(now())
}
